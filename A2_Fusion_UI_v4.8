-- ══════════════════════════════════════════════════════════════════════════════
--  v4.8 • PRESENCE ENGINE  (berapa orang pakai UI / online)
-- ══════════════════════════════════════════════════════════════════════════════
--  Endpoint presence bersifat OPSIONAL. Kalau A2UI.PresenceURL diisi, library
--  akan kirim heartbeat (POST JSON) dan menerima balasan:
--      { "online": 12, "total": 340, "status": "ONLINE" }
--  Kalau tidak diisi, dashboard tetap hidup memakai data server lokal
--  (#Players) supaya tidak pernah kosong / error.
-- ══════════════════════════════════════════════════════════════════════════════
A2UI._presence = { Online = 0, Total = 0, Status = "LOCAL", Updated = 0, OK = false }
A2UI._presenceConns = {}
A2UI._onPresence = nil

local function _presenceSessionId()
    local seed = tostring(os.time()) .. tostring(math.random(1, 1e9))
        .. tostring(A2_ENV.User) .. tostring(A2_ENV.PlaceId)
    local h = 5381
    for i = 1, #seed do
        h = (h * 33 + string.byte(seed, i)) % 4294967296
    end
    return string.format("%08x%04x", h, math.random(0, 65535))
end
A2UI._sessionId = A2UI._sessionId or _presenceSessionId()

function A2UI:SetPresenceURL(url)
    if type(url) == "string" and url:match("^https?://") then
        self.PresenceURL = url
        return true
    end
    self.PresenceURL = nil
    return false
end

local function _httpRequest(opts)
    local fn = nil
    if type(request) == "function" then fn = request
    elseif type(http_request) == "function" then fn = http_request
    elseif type(syn) == "table" and type(syn.request) == "function" then fn = syn.request
    elseif type(http) == "table" and type(http.request) == "function" then fn = http.request end
    if not fn then return nil, "Executor tidak mendukung HTTP request" end
    local ok, res = pcall(fn, opts)
    if not ok then return nil, tostring(res) end
    return res
end

function A2UI:_presenceRequest(payload, url)
    url = url or self.PresenceURL
    if not url then return nil, "PresenceURL belum diisi" end
    local ok, body = pcall(function() return HttpService:JSONEncode(payload) end)
    if not ok then return nil, "Gagal encode JSON" end
    local res, err = _httpRequest({
        Url = url,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body,
    })
    if not res then return nil, err end
    local raw = res.Body or res.body
    if type(raw) ~= "string" or raw == "" then return nil, "Balasan kosong" end
    local okd, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okd or type(data) ~= "table" then return nil, "Balasan bukan JSON" end
    if type(data.data) == "table" then data = data.data end
    return data
end

function A2UI:RefreshPresence()
    local localPlayers = #Players:GetPlayers()
    local st = self._presence

    if not self.PresenceURL then
        st.Online = localPlayers
        st.Total = math.max(st.Total or 0, localPlayers)
        st.Status = "LOCAL"
        st.OK = false
        st.Updated = os.time()
    else
        local data, err = self:_presenceRequest({
            session = self._sessionId,
            user = A2_ENV.User,
            userId = LocalPlayer and LocalPlayer.UserId or 0,
            place = A2_ENV.Place,
            placeId = A2_ENV.PlaceId,
            version = self.Version,
            key = self:GetKeyInfo().Key or "",
            serverPlayers = localPlayers,
            action = "heartbeat",
        })
        if data then
            st.Online = tonumber(data.online) or tonumber(data.Online) or localPlayers
            st.Total = tonumber(data.total) or tonumber(data.Total) or st.Total
            st.Status = tostring(data.status or data.Status or "ONLINE")
            st.OK = true
        else
            st.Online = localPlayers
            st.Status = "OFFLINE"
            st.OK = false
            st.Error = err
        end
        st.Updated = os.time()
    end

    if self._bubbleBadge and self._bubbleBadge.Parent then
        if st.Online and st.Online > 0 then
            self._bubbleBadge.Text = tostring(st.Online)
            self._bubbleBadge.Visible = true
        else
            self._bubbleBadge.Visible = false
        end
    end
    if type(self._onPresence) == "function" then
        pcall(self._onPresence, st)
    end
    return st
end

function A2UI:GetPresence()
    return self._presence
end

function A2UI:StartPresence(interval)
    self:StopPresence()
    interval = math.max(tonumber(interval) or 45, 10)
    self:RefreshPresence()
    local thread = task.spawn(function()
        while self._presenceRunning do
            task.wait(interval)
            if not self._presenceRunning then break end
            pcall(function() A2UI:RefreshPresence() end)
        end
    end)
    self._presenceRunning = true
    self._presenceThread = thread
    return thread
end

function A2UI:StopPresence()
    self._presenceRunning = false
    self._presenceThread = nil
end

-- ══════════════════════════════════════════════════════════════════════════════
--  v4.8 • KEY SYSTEM  (format: A2-<DURASI>-<SALT4>-<CHECK4>)
-- ══════════════════════════════════════════════════════════════════════════════
--  Contoh key valid:
--      A2-7D-9F3A-1C2B     → 7 hari
--      A2-12H-4B7C-9E10    → 12 jam
--      A2-30D-A1B2-C3D4    → 30 hari
--      A2-LIFE-0F0F-1E1E   → lifetime
--  Durasi yang didukung: H (jam), D (hari), W (minggu), M (bulan), Y (tahun),
--  LIFE (permanen). Checksum dihitung dari durasi + salt + A2UI.KeySecret,
--  jadi key tidak bisa dikarang sembarangan.
-- ══════════════════════════════════════════════════════════════════════════════
local KEY_DIR  = "A2Fusion/Key"
local KEY_FILE = KEY_DIR .. "/session.json"
A2UI.KeyDir  = KEY_DIR
A2UI.KeyFile = KEY_FILE
A2UI.Keys    = A2UI.Keys or {}     -- key manual: ["A2-7D-XXXX-XXXX"] = "7D"

local function _keyHash(str)
    local h = 5381
    for i = 1, #str do
        h = (h * 33 + string.byte(str, i)) % 4294967296
    end
    return string.format("%08x", h)
end
A2UI.KeyHash = _keyHash

local function _durSeconds(tag)
    tag = string.upper(tostring(tag or ""))
    if tag == "LIFE" then return math.huge end
    local n, unit = tag:match("^(%d+)([HDWMY])$")
    if not n then return nil end
    n = tonumber(n)
    if not n or n <= 0 then return nil end
    local mult = ({ H = 3600, D = 86400, W = 604800, M = 2592000, Y = 31536000 })[unit]
    return n * mult
end
A2UI.DurationSeconds = _durSeconds

function A2UI:FormatDuration(sec)
    if sec == nil then return "-" end
    if sec == math.huge then return "Lifetime" end
    sec = math.max(0, math.floor(tonumber(sec) or 0))
    if sec <= 0 then return "Habis" end
    local d = math.floor(sec / 86400)
    local h = math.floor((sec % 86400) / 3600)
    local m = math.floor((sec % 3600) / 60)
    if d > 0 then
        if h > 0 then return string.format("%d hari %d jam", d, h) end
        return string.format("%d hari", d)
    end
    if h > 0 then
        if m > 0 then return string.format("%d jam %d menit", h, m) end
        return string.format("%d jam", h)
    end
    return string.format("%d menit", math.max(m, 1))
end

function A2UI:GenerateKey(duration)
    duration = string.upper(tostring(duration or "7D"))
    duration = duration:gsub("%s+", "")
    if duration:match("^%d+$") then duration = duration .. "D" end
    if duration ~= "LIFE" and not duration:match("^%d+[HDWMY]$") then
        return nil, "Format durasi tidak valid (contoh: 7D, 12H, 30D, 1M, LIFE)"
    end
    local salt = string.format("%04X", math.random(0, 65535))
    local chk = string.upper(_keyHash(duration .. salt .. tostring(self.KeySecret)):sub(1, 4))
    local key = "A2-" .. duration .. "-" .. salt .. "-" .. chk
    self.Keys[key] = duration
    return key
end

function A2UI:ParseKey(key)
    if type(key) ~= "string" then return nil, "Key harus berupa teks" end
    key = key:gsub("%s+", ""):upper()
    local dur, salt, chk = key:match("^A2%-(%d+[HDWMY])%-(%x%x%x%x)%-(%x%x%x%x)$")
    if not dur then
        dur, salt, chk = key:match("^A2%-(LIFE)%-(%x%x%x%x)%-(%x%x%x%x)$")
    end
    if not dur then
        -- key manual dari owner (A2UI.Keys) tetap diterima
        if self.Keys[key] then
            return { Key = key, Duration = self.Keys[key], Manual = true }
        end
        return nil, "Format key salah. Contoh: A2-7D-XXXX-XXXX"
    end
    local expect = string.upper(_keyHash(dur .. salt .. tostring(self.KeySecret)):sub(1, 4))
    if chk ~= expect and not self.Keys[key] then
        return nil, "Key tidak valid (checksum salah)"
    end
    local secs = _durSeconds(dur)
    if not secs then return nil, "Durasi key tidak dikenal" end
    return { Key = key, Duration = dur, Seconds = secs, Manual = self.Keys[key] ~= nil }
end

local function _loadKeySession()
    if type(readfile) ~= "function" then return nil end
    local ok, raw = pcall(readfile, KEY_FILE)
    if not ok or type(raw) ~= "string" or raw == "" then return nil end
    local okd, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okd or type(data) ~= "table" then return nil end
    return data
end

local function _saveKeySession(data)
    if type(writefile) ~= "function" then return false end
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" then
            if not isfolder(KEY_DIR) then makefolder(KEY_DIR) end
        end
    end)
    local ok, raw = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false end
    return (pcall(writefile, KEY_FILE, raw))
end

function A2UI:GetKeyInfo()
    local info = { Key = nil, Valid = false, ExpiresAt = 0, Remaining = 0, Duration = nil }
    local data = _loadKeySession()
    if data and data.key then
        local parsed = self:ParseKey(data.key)
        if parsed then
            info.Key = parsed.Key
            info.Duration = parsed.Duration
            info.ExpiresAt = tonumber(data.expiresAt) or 0
            if parsed.Seconds == math.huge then
                info.Valid = true
                info.Remaining = math.huge
            elseif info.ExpiresAt > 0 then
                info.Remaining = info.ExpiresAt - os.time()
                info.Valid = info.Remaining > 0
            end
        end
    end
    return info
end

function A2UI:ClearKey()
    if type(delfile) == "function" then pcall(delfile, KEY_FILE) end
    if type(isfile) == "function" and type(delfile) == "function" then
        if isfile(KEY_FILE) then pcall(delfile, KEY_FILE) end
    end
    self._keyWatcherOn = false
    return true
end

function A2UI:_isKeyBypassed()
    local uid = LocalPlayer and LocalPlayer.UserId or 0
    local name = A2_ENV.User
    for _, v in ipairs(self.KeyBypass or {}) do
        if v == uid or (type(v) == "string" and v:lower() == tostring(name):lower()) then
            return true
        end
    end
    return false
end

function A2UI:ValidateKey(key)
    local parsed, err = self:ParseKey(key)
    if not parsed then return false, err end

    -- Remote validation (opsional). Balasan: { valid = true, expiresAt = 123 }
    if self.KeyURL then
        local data = self:_presenceRequest({
            action = "validate",
            key = parsed.Key,
            user = A2_ENV.User,
            userId = LocalPlayer and LocalPlayer.UserId or 0,
            placeId = A2_ENV.PlaceId,
        }, self.KeyURL)
        if data and data.valid ~= nil then
            if data.valid == false then
                return false, tostring(data.reason or "Key ditolak server")
            end
            parsed.ExpiresAt = tonumber(data.expiresAt) or nil
            parsed.Seconds = parsed.Seconds
            return true, parsed
        end
        -- server tidak bisa dihubungi → fallback ke validasi lokal
    end
    return true, parsed
end

function A2UI:ActivateKey(key)
    local ok, parsed = self:ValidateKey(key)
    if not ok then return false, parsed end
    local expiresAt
    if parsed.Seconds == math.huge then
        expiresAt = 0
    elseif parsed.ExpiresAt and parsed.ExpiresAt > 0 then
        expiresAt = parsed.ExpiresAt
    else
        expiresAt = os.time() + parsed.Seconds
    end
    _saveKeySession({
        key = parsed.Key,
        duration = parsed.Duration,
        expiresAt = expiresAt,
        activatedAt = os.time(),
        user = A2_ENV.User,
        userId = LocalPlayer and LocalPlayer.UserId or 0,
    })
    self:_startKeyWatcher()
    return true, { Key = parsed.Key, Duration = parsed.Duration, ExpiresAt = expiresAt }
end

function A2UI:_startKeyWatcher()
    if self._keyWatcherOn then return end
    self._keyWatcherOn = true
    task.spawn(function()
        while self._keyWatcherOn do
            task.wait(30)
            if not self._keyWatcherOn then break end
            local skip = (not self.KeyRequired) or self:_isKeyBypassed()
            local info = self:GetKeyInfo()
            if (not skip) and (not info.Valid) then
                self._keyWatcherOn = false
                if self.Main and self.Main.Parent then
                    pcall(function() self:Close() end)
                end
                self:Notify({
                    Title = "Key berakhir",
                    Content = "Masa aktif key kamu sudah habis. Masukkan key baru.",
                    Color = "bad", Duration = 8,
                })
                self:ShowKeyGate(function() end)
                break
            end
        end
    end)
end

-- ── KEY GATE UI ──────────────────────────────────────────────────────────────
function A2UI:ShowKeyGate(onSuccess)
    local parent = guiParent()
    if not parent then return nil end
    local existing = parent:FindFirstChild("A2KeyGate")
    if existing then existing:Destroy() end

    local gui = mk("ScreenGui", {
        Name = "A2KeyGate", ResetOnSpawn = false,
        IgnoreGuiInset = true, DisplayOrder = 999999, Parent = parent,
    })
    pcall(function() gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)

    local dim = mk("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bgDeep,
        BackgroundTransparency = 0.25, BorderSizePixel = 0, Parent = gui,
    })

    local card = mk("Frame", {
        Size = UDim2.fromOffset(392, 348), Position = UDim2.fromScale(.5, .5),
        AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = C.bgPanel,
        BorderSizePixel = 0, Parent = gui,
    })
    corner(card, 18)
    stroke(card, C.primary, 1.5, 0.35, true)
    mk("UIGradient", { Color = GRADIENT_PANEL, Rotation = 135, Parent = card })
    local cardScale = mk("UIScale", { Scale = .9, Parent = card })
    TweenService:Create(cardScale, TweenInfo.new(.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Scale = 1 }):Play()

    -- Logo A2 resmi
    local logoUri = assetUri(self.LogoAsset)
    if logoUri then
        mk("ImageLabel", {
            Size = UDim2.fromOffset(64, 64), Position = UDim2.new(.5, 0, 0, 18),
            AnchorPoint = Vector2.new(.5, 0), BackgroundTransparency = 1,
            Image = logoUri, ScaleType = Enum.ScaleType.Fit, Parent = card,
        })
    else
        mk("TextLabel", {
            Size = UDim2.fromOffset(64, 64), Position = UDim2.new(.5, 0, 0, 18),
            AnchorPoint = Vector2.new(.5, 0), BackgroundTransparency = 1, Text = "A2",
            Font = Enum.Font.GothamBlack, TextSize = 34, TextColor3 = C.primary, Parent = card,
        })
    end

    mk("TextLabel", {
        Size = UDim2.new(1, -36, 0, 24), Position = UDim2.new(0, 18, 0, 90),
        BackgroundTransparency = 1, Text = "A2 FUSION • KEY ACCESS",
        Font = Enum.Font.GothamBlack, TextSize = 15, TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Center, Parent = card,
    })
    local sub = mk("TextLabel", {
        Size = UDim2.new(1, -48, 0, 32), Position = UDim2.new(0, 24, 0, 116),
        BackgroundTransparency = 1, Text = "Masukkan key untuk mengaktifkan UI.\nFormat: A2-7D-XXXX-XXXX",
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.dim, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Center, Parent = card,
    })
    textGlow(sub, C.dim, .2)

    local box = mk("TextBox", {
        Size = UDim2.new(1, -48, 0, 42), Position = UDim2.new(0, 24, 0, 160),
        BackgroundColor3 = C.bgRow, BorderSizePixel = 0, Text = "",
        PlaceholderText = "A2-7D-XXXX-XXXX", PlaceholderColor3 = C.dim,
        Font = Enum.Font.Code, TextSize = 15, TextColor3 = C.white,
        ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Center, Parent = card,
    })
    corner(box, 10)
    local boxStroke = stroke(box, C.stroke, 1, .35)

    local status = mk("TextLabel", {
        Size = UDim2.new(1, -48, 0, 18), Position = UDim2.new(0, 24, 0, 208),
        BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamBold,
        TextSize = 11, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = card,
    })

    local btn = mk("TextButton", {
        Size = UDim2.new(1, -48, 0, 42), Position = UDim2.new(0, 24, 0, 232),
        BackgroundColor3 = C.primary, BackgroundTransparency = .88, BorderSizePixel = 0,
        Text = "AKTIVASI KEY", Font = Enum.Font.GothamBlack, TextSize = 13,
        TextColor3 = C.white, AutoButtonColor = false, Parent = card,
    })
    corner(btn, 10)
    stroke(btn, C.primary, 1.2, .25, true)
    textGlow(btn, C.primary, .5)

    local dbtn = mk("TextButton", {
        Size = UDim2.new(1, -48, 0, 34), Position = UDim2.new(0, 24, 0, 284),
        BackgroundColor3 = C.bgRow, BackgroundTransparency = .3, BorderSizePixel = 0,
        Text = "  Discord A2 FUSION", Font = Enum.Font.GothamBold, TextSize = 11,
        TextColor3 = C.dim, AutoButtonColor = false, Parent = card,
    })
    corner(dbtn, 10)
    stroke(dbtn, C.secondary, 1, .55)
    local dIcon = makeIcon(dbtn, "discord", { Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(0, 64, .5, 0), AnchorPoint = Vector2.new(0, .5), Color = C.secondary })
    if dIcon then dIcon.ZIndex = 2 end

    local function setStatus(txt, col)
        status.Text = txt
        status.TextColor3 = col or C.dim
    end

    local function submit()
        local raw = tostring(box.Text or "")
        if raw:gsub("%s", "") == "" then
            setStatus("Key masih kosong.", C.warn)
            return
        end
        setStatus("Memeriksa key...", C.primary)
        local ok, res = self:ActivateKey(raw)
        if not ok then
            setStatus(tostring(res), C.bad)
            boxStroke.Color = C.bad
            return
        end
        boxStroke.Color = C.good
        setStatus("Key aktif • " .. tostring(res.Duration) .. " (" .. self:FormatDuration(
            res.ExpiresAt == 0 and math.huge or (res.ExpiresAt - os.time())) .. ")", C.good)
        task.delay(.55, function()
            if gui and gui.Parent then gui:Destroy() end
            if type(onSuccess) == "function" then
                local okc, err = pcall(onSuccess)
                if not okc then warn("[A2 UI] onSuccess key gate error: " .. tostring(err)) end
            end
        end)
    end

    btn.MouseButton1Click:Connect(submit)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(.15), { BackgroundTransparency = .78 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(.15), { BackgroundTransparency = .88 }):Play()
    end)
    box.FocusLost:Connect(function(enter)
        if enter then submit() end
    end)
    dbtn.MouseButton1Click:Connect(function()
        if type(setclipboard) == "function" then pcall(setclipboard, self.DiscordInvite) end
        self:Notify({ Title = "Discord A2 FUSION", Content = self.DiscordInvite .. " (disalin)", Duration = 6 })
    end)
    task.defer(function() if box.Parent then pcall(function() box:CaptureFocus() end) end end)

    self._keyGate = gui
    return gui
end

function A2UI:RequireKey(onSuccess)
    if not self.KeyRequired or self:_isKeyBypassed() then
        if type(onSuccess) == "function" then onSuccess() end
        return true
    end
    local info = self:GetKeyInfo()
    if info.Valid then
        self:_startKeyWatcher()
        if type(onSuccess) == "function" then onSuccess() end
        return true
    end
    self:ShowKeyGate(onSuccess)
    return false
end

-- ══════════════════════════════════════════════════════════════════════════════
--  v4.8 • STATUS DASHBOARD  (online, total user, status, discord, info key)
-- ══════════════════════════════════════════════════════════════════════════════
--  Pakai:  local dash = window:AddStatusDashboard(home)
--          dash:Refresh()  -- paksa update
-- ══════════════════════════════════════════════════════════════════════════════
function A2UI:AddStatusDashboard(tab, opts)
    opts = opts or {}
    local sec = tab:Section({ Title = opts.Title or "Live Status" })

    local stats = sec:Stats({
        Stats = {
            { Title = "ONLINE",     Value = "0", Color = "good" },
            { Title = "TOTAL USER", Value = "0", Color = "primary" },
            { Title = "STATUS",     Value = "LOCAL", Color = "warn" },
        },
    })

    local info = sec:Label({
        Text = "Menghubungkan...", Size = 12, Color = "dim",
    })
    local keyLbl = sec:Label({
        Text = "Key: -", Size = 12, Color = "secondary",
    })

    local function apply(st)
        st = st or self:GetPresence()
        stats:Set("ONLINE", tostring(st.Online or 0))
        stats:Set("TOTAL USER", tostring(st.Total or 0))
        stats:Set("STATUS", tostring(st.Status or "-"))
        local when = st.Updated and os.date("%H:%M:%S", st.Updated) or "-"
        local mode = self.PresenceURL and "Endpoint" or "Server lokal"
        info:Set(string.format("%s • %s • update %s", A2_ENV.Place, mode, when))
        local ki = self:GetKeyInfo()
        if ki.Valid then
            keyLbl:Set(string.format("Key: %s • sisa %s", tostring(ki.Key),
                self:FormatDuration(ki.Remaining)))
            keyLbl:SetColor(C.good)
        else
            keyLbl:Set("Key: belum aktif / habis")
            keyLbl:SetColor(C.bad)
        end
    end

    self._onPresence = apply
    A2UI._onPresence = apply   -- heartbeat global (A2UI:StartPresence) ikut update
    apply(self:GetPresence())

    local row = sec:ButtonGroup({
        Buttons = {
            { Title = "Refresh Status", Color = "primary", Glow = true, Callback = function()
                self:RefreshPresence()
                apply()
                self:Notify({ Title = "Status", Content = "Data presence diperbarui.", Duration = 3 })
            end },
            { Title = "Cek Key", Color = "secondary", Callback = function()
                apply()
                local ki = self:GetKeyInfo()
                self:Notify({ Title = "Info Key", Color = ki.Valid and "good" or "bad",
                    Content = ki.Valid and ("Aktif • sisa " .. self:FormatDuration(ki.Remaining))
                        or "Key belum aktif.", Duration = 5 })
            end },
        },
    })

    local com = tab:Section({ Title = opts.CommunityTitle or "Community" })
    com:Paragraph({
        Title = "Discord A2 FUSION",
        Desc = "Gabung untuk update, key baru, dan bantuan.\n" .. tostring(self.DiscordInvite),
        Color = "secondary", Shine = true,
    })
    com:Button({
        Title = "Join Discord A2 FUSION", Icon = "discord", Glow = true, Shine = true,
        Color = "primary", Desc = "Buka invite / salin link ke clipboard.",
        Callback = function() self:OpenDiscordInvite() end,
    })
    com:Button({
        Title = "Salin Link Discord", Color = "secondary",
        Callback = function()
            if type(setclipboard) == "function" then pcall(setclipboard, self.DiscordInvite) end
            self:Notify({ Title = "Discord", Content = "Link disalin: " .. self.DiscordInvite, Duration = 5 })
        end,
    })

    return {
        Refresh = function() self:RefreshPresence(); apply() end,
        Apply = apply,
        Section = sec,
        Community = com,
        Stats = stats,
        InfoLabel = info,
        KeyLabel = keyLbl,
        Buttons = row,
    }
end

function A2UI:MountDemo()
    if self._demoMounting then return end
    self._demoMounting = true
    local defer = (task and task.defer) or (task and task.spawn) or spawn
    defer(function()
        local parent = guiParent()
        if not parent then
            warn("[A2 UI] Tidak menemukan parent GUI")
            return
        end

        -- ══ v4.8: TANPA INTRO — window langsung muncul (tidak load lama) ══
        local mounted = false
        local function mount()
            if mounted then return end
            mounted = true
            A2UI._demoMounting = false
            local window = A2UI:Boot({
                Title = "A2 FUSION",
                Author = "Theme: Vietnamese Neon • Engine: A2",
                SidebarTitle = "MENU",
                Status = A2_ENV.Executor,
                OpenButton = { Enabled = true },
            })
            if not window then return end
            A2UI.Window = window
            window:ShowWindow()
            -- v4.8: presence (jumlah online / total user) langsung jalan.
            pcall(function() A2UI:StartPresence(45) end)
            A2UI:Notify({
                Title = "A2 FUSION siap",
                Content = "Executor: " .. A2_ENV.Executor .. " • " .. A2_ENV.Place,
                Color = "primary",
            })

            -- ── Contoh tab Home ──
            local home = window:Tab({ Title = "Dashboard", Icon = "home" })
            window:AddDashboardMusic(home)
            -- v4.8: dashboard status live (online, total user, status, discord, key)
            local dash = window:AddStatusDashboard(home)
            A2UI._dashboard = dash
            local community = home:Section({ Title = "Community" })
            community:Button({ Title = "Discord A2 FUSION", Icon = "discord", Glow = true, Shine = true,
                Callback = function() window:OpenDiscordInvite() end })
            local featureGrid = home:FeatureGrid({ CardHeight = 108 })
            featureGrid:Card({ Title = "Survival", Desc = "Tiga fitur survival dalam satu dashboard.", Icon = "shield", Color = "good", LayoutOrder = 1, Callback = function() A2UI:Notify({ Title = "Survival", Content = "Menu survival dibuka.", Color = "good" }) end })
            featureGrid:Card({ Title = "Fly", Desc = "Flight control dan movement settings.", Icon = "rocket", Color = "secondary", LayoutOrder = 2, Callback = function() A2UI:Notify({ Title = "Fly", Content = "Fly control dipilih.", Color = "secondary" }) end })
            featureGrid:Card({ Title = "Skillcheck", Desc = "Timing assist dan precision module.", Icon = "bolt", Color = "primary", LayoutOrder = 3, Callback = function() A2UI:Notify({ Title = "Skillcheck", Content = "Skillcheck dipilih.", Color = "primary" }) end })
            featureGrid:Card({ Title = "ESP", Desc = "Visual information dan range settings.", Icon = "eye", Color = "warn", LayoutOrder = 4, Callback = function() A2UI:Notify({ Title = "ESP", Content = "ESP dipilih.", Color = "warn" }) end })
            local hs = home:Section({ Title = "Environment" })
            hs:Paragraph({
                Title = "Execution detected",
                Desc = "Executor: " .. A2_ENV.Executor
                    .. "\nPlace: " .. A2_ENV.Place .. " (ID: " .. tostring(A2_ENV.PlaceId) .. ")"
                    .. "\nUser: " .. A2_ENV.User .. (A2_ENV.Mobile and " • Mobile" or " • Desktop"),
                Color = "primary", Shine = true,
            })
            hs:Button({ Title = "Test Notification", Icon = "bolt", Glow = true, Shine = true, Callback = function()
                A2UI:Notify({ Title = "A2 FUSION", Content = "Semua sistem berjalan normal.", Color = "secondary" })
            end })

            -- ── Contoh tab Farm ──
            local farm = window:Tab({ Title = "Farm", Icon = "rocket" })
            local fs = farm:Section({ Title = "Farm Control" })
            fs:Toggle({ Title = "Enable Farm", Desc = "Aktifkan loop farm otomatis.", Value = false, Flag = "farm.enabled",
                Callback = function(enabled)
                    A2UI:Notify({ Title = "Farm", Content = enabled and "Farm dimulai." or "Farm dihentikan.", Color = enabled and "good" or "bad" })
                end })
            fs:Slider({ Title = "Farm Delay", Desc = "Jeda antar aksi.", Step = 0.1, Flag = "farm.delay",
                Value = { Min = 0.1, Max = 10, Default = 1 } })
            fs:RangeSlider({ Title = "Farm Radius", Desc = "Atur radius minimum–maksimum (klik lalu pakai panah / Tab).", Step = 5, Flag = "farm.radius",
                Value = { Min = 0, Max = 500, DefaultMin = 50, DefaultMax = 250 } })
            fs:Button({ Title = "Start Farm", Icon = "play", Glow = true, Shine = true, Color = "good" })

            -- ── Contoh tab Components (v4.5) ──
            local comp = window:Tab({ Title = "Components", Icon = "bolt" })
            local cg = comp:Section({ Title = "Glow & Text" })
            cg:GlowText({ Text = "A2 FUSION COMMUNITY" })
            cg:Label({ Text = "Teks pulse glow dengan warna aksen.", Glow = true, Color = "primary" })
            cg:Badges({ Badges = { { Text = "VIP", Color = "warn", Glow = true }, { Text = "PREMIUM", Glow = "rainbow" },
                { Text = "ONLINE", Color = "good" }, { Text = "BETA", Color = "bad" } } })
            cg:Stats({ Stats = { { Title = "FPS", Value = "60", Color = "good" }, { Title = "Ping", Value = "42ms", Color = "primary" },
                { Title = "Players", Value = tostring(#Players:GetPlayers()), Color = "warn" } } })
            local cc = comp:Section({ Title = "Controls" })
            local textCol = cg:Label({ Text = "Ubah warna teks ini lewat Color Picker di bawah.", Size = 14, Bold = true })
            cc:ColorPicker({ Title = "Warna Teks", Default = Color3.fromRGB(0, 229, 255), Flag = "demo.color",
                Callback = function(c) textCol:SetColor(c) end })
            cc:Keybind({ Title = "Toggle UI", Default = "RightShift", Flag = "demo.key",
                Callback = function() if window._visible then window:Close() else window:Open() end end })
            cc:Checkbox({ Title = "Auto Collect", Color = "good", Flag = "demo.check" })
            cc:MultiDropdown({ Title = "Target ESP", Values = { "Player", "NPC", "Item", "Chest" }, Value = { "Player" }, Flag = "demo.multi" })
            cc:Stepper({ Title = "Jumlah", Min = 1, Max = 50, Default = 5, Flag = "demo.step" })
            cc:Divider("PROGRESS")
            local pb = cc:ProgressBar({ Title = "Loading Farm", Value = 35, Glow = true })
            cc:ButtonGroup({ Buttons = {
                { Title = "−10%", Color = "bad", Callback = function() pb:Set(pb:Get() - 10) end },
                { Title = "Reset", Color = "secondary", Callback = function() pb:Set(0) end },
                { Title = "+10%", Color = "good", Glow = "rainbow", Callback = function() pb:Set(pb:Get() + 10) end },
            } })
            comp:ThemeSection({ Flag = "theme" })

            -- ── Contoh tab Settings ──
            local settings = window:Tab({ Title = "Settings", Icon = "settings" })
            local ss = settings:Section({ Title = "General" })
            A2UI:AddCharacterPreview(ss, { Title = "3D CHARACTER • " .. A2_ENV.User })
            ss:Dropdown({ Title = "Mode", Values = { "Legit", "Fast", "AFK" }, Value = "Legit" })
            ss:Input({ Title = "Target Name", Placeholder = "Masukkan nama target..." })
            ss:Toggle({ Title = "Auto Execute", Desc = "Jalankan semua file di A2Fusion/AutoExec saat UI dibuka.",
                Value = A2UI:IsAutoExecEnabled(),
                Callback = function(v) A2UI:SetAutoExecEnabled(v) end })
            ss:Button({ Title = "Jalankan AutoExec Sekarang", Icon = "play", Color = "good", Callback = function()
                local okx, resx = A2UI:RunAutoExecFolder()
                A2UI:Notify({ Title = okx and "AutoExec" or "AutoExec gagal", Content = tostring(resx), Duration = 6 })
            end })
            ss:Toggle({ Title = "Anti-AFK", Desc = "Cegah kick karena idle.", Flag = "misc.antiafk",
                Callback = function(v) A2UI:SetAntiAFK(v) end })
            -- ── v4.8: info key + ganti key ──
            local ks = settings:Section({ Title = "Key Access" })
            local keyInfo = ks:Label({ Text = "", Size = 12, Color = "secondary" })
            local function refreshKeyInfo()
                local ki = A2UI:GetKeyInfo()
                if ki.Valid then
                    keyInfo:Set(string.format("Key: %s\nDurasi: %s • Sisa: %s", tostring(ki.Key),
                        tostring(ki.Duration), A2UI:FormatDuration(ki.Remaining)))
                    keyInfo:SetColor(C.good)
                else
                    keyInfo:Set("Key belum aktif atau sudah habis.\nFormat: A2-7D-XXXX-XXXX")
                    keyInfo:SetColor(C.bad)
                end
            end
            refreshKeyInfo()
            ks:ButtonGroup({ Buttons = {
                { Title = "Refresh Info Key", Color = "secondary", Callback = refreshKeyInfo },
                { Title = "Ganti Key", Color = "primary", Glow = true, Callback = function()
                    A2UI:ClearKey()
                    refreshKeyInfo()
                    A2UI:ShowKeyGate(function()
                        refreshKeyInfo()
                        A2UI:Notify({ Title = "Key aktif", Content = "UI siap dipakai.", Color = "good" })
                    end)
                end },
            } })
            ks:Button({ Title = "Generate Key (Owner)", Icon = "bolt", Color = "warn",
                Desc = "Buat key durasi baru. Contoh: 7D / 12H / 30D / LIFE",
                Callback = function()
                    local key = A2UI:GenerateKey("7D")
                    if type(setclipboard) == "function" then pcall(setclipboard, key) end
                    A2UI:Notify({ Title = "Key 7D dibuat", Content = tostring(key) .. " (disalin)", Duration = 8 })
                end })

            local cs = settings:Section({ Title = "Config" })
            local cfgName = "slot1"
            cs:Input({ Title = "Nama Config", Placeholder = "slot1", Callback = function(t)
                if t ~= "" then cfgName = t end
            end })
            local cfgDrop
            cfgDrop = cs:Dropdown({ Title = "Pilih Config", Values = A2UI:ListConfigs(), Value = "Pilih...",
                Callback = function(v)
                    cfgName = tostring(v)
                    local okc, resc = window:LoadConfig(cfgName)
                    A2UI:Notify({ Title = okc and ("Config '" .. cfgName .. "' dimuat") or "Gagal load", Content = tostring(resc) })
                end })
            cs:Button({ Title = "Simpan Config", Icon = "save", Color = "secondary", Callback = function()
                local okc, resc = window:SaveConfig(cfgName)
                cfgDrop.Refresh(A2UI:ListConfigs())
                A2UI:Notify({ Title = okc and "Config disimpan" or "Gagal simpan", Content = tostring(resc) })
            end })
            cs:Button({ Title = "Refresh Daftar", Icon = "refresh", Callback = function()
                cfgDrop.Refresh(A2UI:ListConfigs())
            end })
            cs:Button({ Title = "Hapus Config", Icon = "close", Color = "bad", Callback = function()
                local okc, resc = A2UI:DeleteConfig(cfgName)
                cfgDrop.Refresh(A2UI:ListConfigs())
                A2UI:Notify({ Title = okc and "Dihapus" or "Gagal hapus", Content = tostring(resc) })
            end })

            local ws = settings:Section({ Title = "Discord Webhook" })
            ws:Input({
                Title = "Webhook URL",
                Placeholder = "https://discord.com/api/webhooks/...",
                Callback = function(url)
                    local okw, reason = window:SetWebhook(url)
                    A2UI:Notify({ Title = okw and "Webhook tersimpan" or "Webhook gagal", Content = okw and "URL hanya disimpan di sesi ini." or reason })
                end,
            })
            ws:Button({
                Title = "Test Webhook", Desc = "Kirim satu pesan percobaan ke Discord.", Color = "primary",
                Callback = function()
                    local okw, reason = window:Webhook({ Content = "Test webhook dari A2 FUSION berhasil." })
                    A2UI:Notify({ Title = okw and "Webhook terkirim" or "Webhook gagal", Content = okw and "Cek channel Discord kamu." or reason })
                end,
            })

            -- ── Contoh tab Survival ──
            local sv = window:Tab({ Title = "Survival", Icon = "survival" })
            local svs = sv:Section({ Title = "Survival Features" })
            svs:Toggle({ Title = "Auto Heal", Desc = "Heal otomatis saat HP rendah.", Flag = "survival.autoheal" })
            svs:Toggle({ Title = "God Mode", Flag = "survival.god" })
            svs:Slider({ Title = "Heal Threshold", Step = 5, Flag = "survival.threshold",
                Value = { Min = 0, Max = 100, Default = 40 } })

            -- ── Auto-Execute: rejoin = UI auto load lagi ──
            local ax = settings:Section({ Title = "Auto-Execute (rejoin auto load)" })
            ax:Input({ Title = "Loader URL", Flag = "loader.url",
                Placeholder = "https://raw.githubusercontent.com/USER/REPO/main/A2Loader.lua",
                Callback = function(url)
                    if url ~= "" then window:SetLoaderURL(url) end
                end })
            ax:Button({ Title = "Install Auto-Execute", Desc = "Tulis loader ke folder Autoexecute executor.",
                Icon = "bolt", Glow = true, Shine = true, Color = "good",
                Callback = function()
                    local oke, res = window:InstallAutoExecute()
                    A2UI:Notify({ Title = oke and "Auto-execute terinstall" or "Gagal install",
                        Content = tostring(res), Duration = 6 })
                end })

            -- Jalankan folder A2Fusion/AutoExec langsung saat UI terbuka
            task.spawn(function()
                if A2UI:IsAutoExecEnabled() then
                    local okx, resx, n = A2UI:RunAutoExecFolder()
                    if okx and (n or 0) > 0 then
                        A2UI:Notify({ Title = "AutoExec", Content = tostring(resx), Duration = 5 })
                    end
                end
            end)
            -- Auto-load config terakhir tiap UI dibuka
            task.delay(0.6, function()
                local okc, resc = window:LoadConfig("autosave")
                if okc then
                    A2UI:Notify({ Title = "Auto-load config", Content = tostring(resc) })
                end
            end)
        end
        -- v4.8: intro dimatikan default supaya tidak ada loading lama.
        if A2UI.ShowIntro then
            -- Intro failures must never prevent the main window from opening.
            task.delay(8, function()
                if mounted then return end
                warn("[A2 UI] Intro timeout; membuka window langsung")
                local intro = parent:FindFirstChild("A2Intro")
                if intro then intro:Destroy() end
                mount()
            end)
            local ok, err = pcall(function() PlayIntro(parent, mount) end)
            if not ok then
                warn("[A2 UI] Intro gagal: " .. tostring(err))
                mount()
            end
        else
            local intro = parent:FindFirstChild("A2Intro")
            if intro then intro:Destroy() end
            -- Script hanya bisa dipakai setelah key valid dimasukkan.
            -- Kalau key sudah tersimpan & belum habis, mount() jalan langsung.
            A2UI:RequireKey(mount)
        end
    end)
end

if not isModuleScript() and not skipAutoMount then
    A2UI:MountDemo()
end

return A2UI
