    card.Position = UDim2.new(1, 50, 0, 0)
    TweenService:Create(card, TweenInfo.new(0.28, Enum.EasingStyle.Quint), { Position = UDim2.new(0, 0, 0, 0) }):Play()

    task.delay(tonumber(opts.Duration) or 4, function()
        if card and card.Parent then
            local out = TweenService:Create(card, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
            out:Play()
            for _, d in ipairs(card:GetDescendants()) do
                if d:IsA("TextLabel") then
                    TweenService:Create(d, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
                elseif d:IsA("Frame") then
                    TweenService:Create(d, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
                end
            end
            task.wait(0.3)
            pcall(function() card:Destroy() end)
        end
    end)
end

-- ═══════════════════════ A2 3D WATERMARK ══════════════════════════════════
-- Local layered typography: no external logo asset needed.
function A2UI:CreateA2Watermark(parent, opts)
    opts = opts or {}
    parent = parent or self.Gui
    if not parent then return nil end
    if parent:IsA("PlayerGui") or parent:IsA("CoreGui") then parent = overlayGui(parent) end
    local holder = mk("Frame", {
        Name = "A2Watermark3D", AnchorPoint = opts.AnchorPoint or Vector2.new(1, 0),
        Position = opts.Position or UDim2.new(1, -16, 0, 16),
        Size = opts.Size or UDim2.fromOffset(112, 78), BackgroundTransparency = 1,
        ClipsDescendants = false, ZIndex = opts.ZIndex or 120, Parent = parent,
    })

    -- v4.8: logo A2 memakai asset resmi (bukan teks 3D lagi).
    local logoUri = assetUri(opts.Image or A2UI.LogoAsset)
    if logoUri and opts.Image ~= false then
        local hasTag2 = opts.Tag ~= ""
        local img = mk("ImageLabel", {
            Name = "A2LogoImage", Size = UDim2.new(1, 0, 1, hasTag2 and -16 or 0),
            BackgroundTransparency = 1, Image = logoUri, ImageColor3 = opts.Color or C.white,
            ScaleType = Enum.ScaleType.Fit, ZIndex = holder.ZIndex + 1, Parent = holder,
        })
        if hasTag2 then
            mk("TextLabel", {
                Position = UDim2.new(0, 0, 1, -14), Size = UDim2.new(1, 0, 0, 14),
                BackgroundTransparency = 1, Text = opts.Tag or "A2 FUSION",
                Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = C.primary,
                ZIndex = holder.ZIndex + 2, NoTextScale = true, Parent = holder,
            })
        end
        return holder
    end

    local depth = opts.Depth or 5
    local hasTag = opts.Tag ~= ""
    for i = depth, 0, -1 do
        local face = mk("TextLabel", {
            Name = i == 0 and "A2Face" or ("A2Depth" .. i),
            Size = UDim2.new(1, -depth * 2, 1, hasTag and -18 or -depth),
            Position = UDim2.fromOffset(depth + i, i), BackgroundTransparency = 1,
            Text = opts.Text or "A2", Font = Enum.Font.GothamBlack,
            TextSize = opts.TextSize or 46, TextColor3 = i == 0 and C.white or C.secondary,
            TextStrokeColor3 = i == 0 and C.glow or C.bgDeep,
            TextStrokeTransparency = i == 0 and .48 or .92,
            TextTransparency = i == 0 and 0 or .12 + i * .06,
            Rotation = 0, ZIndex = holder.ZIndex + depth - i + 1, NoTextScale = true, Parent = holder,
        })
        if i == 0 then
            mk("UIGradient", {Color = GRADIENT_TITLE, Rotation = 90, Parent = face})
        end
    end
    if hasTag then
        mk("TextLabel", {
            Position = UDim2.new(0, 0, 1, -16), Size = UDim2.new(1, 0, 0, 14),
            BackgroundTransparency = 1, Text = opts.Tag or "A2 FUSION",
            Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = C.primary,
            ZIndex = holder.ZIndex + depth + 2, NoTextScale = true, Parent = holder,
        })
    end
    return holder
end

-- ═══════════════════════ 3D CHARACTER PREVIEW ═════════════════════════════
-- Bounding-box framing supports both R6/R15 and differently sized avatars.
-- ViewportFrame lighting is used; PointLight/Highlight do not render reliably here.
-- ═══════════════════════════ AVATAR ENGINE (shared, live-capable) ═══════════════════════════
-- Merender avatar di dalam ViewportFrame. Mendukung:
--   • Mode showcase (diam / berputar) — default.
--   • Mode LIVE: menyalin CFrame setiap part dari karakter asli pemain tiap frame,
--     sehingga preview ikut bergerak (lari / lompat) saat UI terbuka.
-- Ringan: satu loop Heartbeat yang di-throttle ~30fps, tanpa RenderStepped.
local function createAvatarEngine(viewport, opts)
    opts = opts or {}
    local engine = { Viewport = viewport, Destroyed = false }

    local world = mk("WorldModel", { Parent = viewport })
    local camera = mk("Camera", { FieldOfView = opts.FieldOfView or 35, Parent = viewport })
    viewport.CurrentCamera = camera

    local message = mk("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = opts.LoadingText or "Memuat karakter…", TextSize = 12, Font = Enum.Font.Gotham,
        TextColor3 = C.dim, ZIndex = 3, Parent = viewport,
    })

    local model, pedestal
    local connections = {}
    local generation = 0
    local radius, height, bottom, angle = 2, 5, -2.5, math.rad(15)
    local rotAcc, liveAcc = 0, 0
    local live = opts.Live == true
    local neutralRootCF
    local cloneParts, realParts, restCFrames = {}, {}, {}

    local function isVisible()
        local node = viewport
        while node do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("ScreenGui") and not node.Enabled then return false end
            node = node.Parent
        end
        return true
    end

    local function frameCamera()
        if not model or engine.Destroyed then return end
        local size = viewport.AbsoluteSize
        if size.X < 1 or size.Y < 1 then return end
        local halfVertical = math.rad(camera.FieldOfView * .5)
        local halfHorizontal = math.atan(math.tan(halfVertical) * size.X / size.Y)
        -- Silinder invariant-rotasi membungkus seluruh avatar + pedestal.
        local distance = math.max((height * .5 + .35) / math.tan(halfVertical),
            radius / math.tan(halfHorizontal)) * 1.12 + radius
        local target = Vector3.new(0, -.12, 0)
        camera.CFrame = CFrame.lookAt(target + Vector3.new(0, distance * .06, distance), target)
    end
    table.insert(connections, viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(frameCamera))

    -- Jalur unik sebuah part (mis. "UpperTorso/LeftUpperArm") untuk mencocokkan
    -- part clone dengan part karakter asli.
    local function partPath(part, root)
        local names = { part.Name }
        local node = part.Parent
        while node and node ~= root do
            table.insert(names, 1, node.Name)
            node = node.Parent
        end
        return table.concat(names, "/")
    end

    local function buildPartMaps()
        cloneParts, realParts, restCFrames = {}, {}, {}
        if model then
            for _, object in ipairs(model:GetDescendants()) do
                if object:IsA("BasePart") then
                    local path = partPath(object, model)
                    cloneParts[path] = object
                    restCFrames[path] = object.CFrame -- pose "diam" (center + hadap kamera)
                end
            end
        end
        local real = LocalPlayer and LocalPlayer.Character
        if real then
            for _, object in ipairs(real:GetDescendants()) do
                if object:IsA("BasePart") then realParts[partPath(object, real)] = object end
            end
        end
    end

    -- Terapkan pose "diam" (showcase) dengan rotasi tambahan rotAngle terhadap origin.
    -- Per-part (bukan PivotTo) supaya transisi LIVE <-> STOP selalu bersih.
    local function renderRest(rotAngle)
        local rot = CFrame.Angles(0, rotAngle or 0, 0)
        for path, part in pairs(cloneParts) do
            local rest = restCFrames[path]
            if rest then part.CFrame = rot * rest end
        end
    end

    -- Salin pose karakter asli ke clone: setiap part clone diletakkan pada
    -- neutralRootCF * (posisi part asli relatif ke HumanoidRootPart asli).
    local function renderLive()
        local real = LocalPlayer and LocalPlayer.Character
        if not real or not model or not neutralRootCF then return false end
        local realRoot = real:FindFirstChild("HumanoidRootPart")
        if not realRoot then return false end
        local realRootCF = realRoot.CFrame
        local moved = false
        for path, clonePart in pairs(cloneParts) do
            local realPart = realParts[path]
            if realPart then
                clonePart.CFrame = neutralRootCF * realRootCF:ToObjectSpace(realPart.CFrame)
                moved = true
            end
        end
        return moved
    end

    local function startLoop()
        if engine.Loop or engine.Destroyed then return end
        engine.Loop = RunService.Heartbeat:Connect(function(dt)
            if engine.Destroyed or not model or not model.Parent or not isVisible() then return end
            if live then
                liveAcc = liveAcc + (dt or 0)
                if liveAcc < 0.033 then return end -- throttle ~30fps
                liveAcc = 0
                if not renderLive() and opts.Rotate ~= false then
                    angle = (angle + math.rad(tonumber(opts.RotationSpeed) or 18) * 0.033) % (2 * math.pi)
                    renderRest(angle)
                end
            elseif opts.Rotate ~= false then
                rotAcc = rotAcc + (dt or 0)
                if rotAcc < 0.033 then return end -- throttle ~30fps
                angle = (angle + math.rad(tonumber(opts.RotationSpeed) or 18) * math.min(rotAcc, .1)) % (2 * math.pi)
                rotAcc = 0
                renderRest(angle)
            end
        end)
    end

    local function loadAvatar()
        generation = generation + 1
        local ticket = generation
        task.spawn(function()
            local candidate
            local userId = tonumber(opts.UserId) or (LocalPlayer and LocalPlayer.UserId)
            -- Clone karakter asli lebih dulu (mempertahankan R6/R15 + outfit saat ini).
            if LocalPlayer and userId == LocalPlayer.UserId and LocalPlayer.Character then
                local character = LocalPlayer.Character
                local wasArchivable = character.Archivable
                local ok, clone = pcall(function()
                    character.Archivable = true
                    return character:Clone()
                end)
                pcall(function() character.Archivable = wasArchivable end)
                if ok then candidate = clone end
            end
            if not candidate and userId then
                local ok, result = pcall(function()
                    local description = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
                    return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
                end)
                if ok then candidate = result end
            end
            if engine.Destroyed or ticket ~= generation then
                if candidate then candidate:Destroy() end
                return
            end
            if not candidate then
                message.Text = opts.MissingText or "Karakter belum tersedia"
                message.Visible = model == nil
                return
            end
            if model then model:Destroy() end
            if pedestal then pedestal:Destroy() end
            model = candidate
            for _, object in ipairs(model:GetDescendants()) do
                if object:IsA("Script") or object:IsA("LocalScript") or object:IsA("ModuleScript") then
                    object:Destroy()
                elseif object:IsA("BasePart") then
                    object.Anchored = true; object.CanCollide = false
                    object.CastShadow = false
                    if object.Name == "HumanoidRootPart" then object.Transparency = 1 end
                end
            end
            model.Parent = world
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                local animator = humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
                end
            end
            model:PivotTo(CFrame.new())
            local bounds, size = model:GetBoundingBox()
            -- Pusatkan di origin + hadapkan ke kamera. Front karakter Roblox = -Z
            -- sedangkan kamera di +Z, jadi perlu rotasi 180°. Rotasi diterapkan
            -- terhadap origin (titik pusat) agar model tetap center.
            model:PivotTo(CFrame.Angles(0, math.pi, 0) * CFrame.new(-bounds.Position) * model:GetPivot())
            height = size.Y
            bottom = -height * .5
            radius = math.max(math.sqrt(size.X * size.X + size.Z * size.Z) * .5, 1.8)
            -- Pedestal baja tipis di bawah kaki (bukan disk neon besar).
            if opts.Pedestal ~= false then
                pedestal = mk("Part", {
                    Name = "AvatarPedestal", Anchored = true, CanCollide = false,
                    Shape = Enum.PartType.Cylinder, Size = Vector3.new(.12, radius * 2, radius * 2),
                    CFrame = CFrame.new(0, bottom - .1, 0) * CFrame.Angles(0, 0, math.pi * .5),
                    Material = Enum.Material.SmoothPlastic, Color = C.secondary,
                    Transparency = .35, Parent = world,
                })
            end
            message.Visible = false
            buildPartMaps()
            local rootPart = model:FindFirstChild("HumanoidRootPart")
            neutralRootCF = rootPart and rootPart.CFrame or model:GetPivot()
            angle = 0
            renderRest(angle)
            frameCamera()
            startLoop()
        end)
    end

    if LocalPlayer and (opts.UserId == nil or tonumber(opts.UserId) == LocalPlayer.UserId) then
        table.insert(connections, LocalPlayer.CharacterAppearanceLoaded:Connect(loadAvatar))
        table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
            task.delay(.5, function() if not engine.Destroyed then loadAvatar() end end)
        end))
    end

    function engine:SetLive(state)
        live = state and true or false
        if not live then renderRest(angle) end -- kembalikan ke pose diam
        return live
    end
    function engine:IsLive() return live end
    function engine:Reload() loadAvatar() end
    function engine:Destroy()
        engine.Destroyed = true
        generation = generation + 1
        if engine.Loop then engine.Loop:Disconnect(); engine.Loop = nil end
        for _, connection in ipairs(connections) do connection:Disconnect() end
        connections = {}
    end

    loadAvatar()
    return engine
end

-- ═══════════════════════════ 3D CHARACTER PREVIEW (in-tab) ═══════════════════════════
-- Framing bounding-box mendukung R6/R15 dan avatar berukuran berbeda.
function A2UI:AddCharacterPreview(section, opts)
    opts = opts or {}
    local isSection = type(section) == "table" and section._inner ~= nil
    local parent = isSection and section._inner or section
    if not parent then return nil end
    if isSection then section._count = (section._count or 0) + 1 end
    local card = mk("Frame", {
        Name = "A2CharacterPreview", Size = UDim2.new(1, 0, 0, opts.Height or 260),
        BackgroundColor3 = C.bgRow, BorderSizePixel = 0,
        LayoutOrder = isSection and section._count or 1, Parent = parent,
    })
    corner(card, 12); stroke(card, C.secondary, 1, .45)
    local title = mk("TextLabel", {
        Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 8),
        BackgroundTransparency = 1, Text = opts.Title or "3D CHARACTER",
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = card,
    })
    textGlow(title, C.glow, .62)
    local viewport = mk("ViewportFrame", {
        Name = "AvatarViewport", Size = UDim2.new(1, -24, 1, -48),
        Position = UDim2.fromOffset(12, 36), BackgroundColor3 = C.bgDeep,
        BorderSizePixel = 0, Ambient = C.primary, LightColor = C.white,
        LightDirection = Vector3.new(-1, -1, -2), Parent = card,
    })
    corner(viewport, 10)
    local engine = createAvatarEngine(viewport, opts)
    card.Destroying:Connect(function() engine:Destroy() end)
    return card
end

-- ═══════════════════════════ FLOATING PREVIEW PERSISTENCE ═══════════════════════════
-- Persistensi posisi & status kunci kartu preview mengapung (biar tidak "loncat").
local FLOAT_PREVIEW_DIR = "A2Fusion/UI"
local FLOAT_PREVIEW_FILE = FLOAT_PREVIEW_DIR .. "/floating_preview.json"
local function loadFloatingPreviewState()
    if type(readfile) ~= "function" then return nil end
    local ok, body = pcall(readfile, FLOAT_PREVIEW_FILE)
    if not ok or not body or body == "" then return nil end
    local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
    if ok2 and type(data) == "table" then return data end
    return nil
end
local function saveFloatingPreviewState(state)
    if type(writefile) ~= "function" then return end
    pcall(function()
        ensureDir(FLOAT_PREVIEW_DIR)
        writefile(FLOAT_PREVIEW_FILE, HttpService:JSONEncode(state))
    end)
end

-- ═══════════════════════════ FLOATING LIVE PREVIEW (di LUAR window) ═══════════════════════════
-- Kartu 3D karakter yang mengapung di sisi kanan layar (di luar UI utama).
-- • Default TERKUNCI di posisinya (tidak bergeser sendiri).
-- • Tap tombol LOCK/MOVE untuk membuka kunci, lalu geser dari mana saja.
-- • Posisi & status kunci DISIMPAN (persisten) supaya tidak balik/loncat.
function A2UI:CreateFloatingPreview(opts)
    opts = opts or {}
    if not self.Gui then return nil end
    local old = self.Gui:FindFirstChild("A2FloatingPreview")
    if old then old:Destroy() end

    local mobile = A2_ENV and A2_ENV.Mobile
    local size = opts.Size or (mobile and UDim2.fromOffset(150, 224) or UDim2.fromOffset(200, 300))
    local anchor = opts.AnchorPoint or (mobile and Vector2.new(1, 1) or Vector2.new(1, 0.5))
    local pos = opts.Position or (mobile and UDim2.new(1, -10, 1, -10) or UDim2.new(1, -14, 0.5, 0))

    -- Muat posisi & status kunci tersimpan (kalau ada).
    local saved = loadFloatingPreviewState()
    local defaultLocked
    if opts.Locked ~= nil then defaultLocked = opts.Locked == true
    else defaultLocked = (A2UI.FloatingPreviewLocked == true) end
    local locked = (saved and saved.locked ~= nil) and saved.locked or defaultLocked
    if saved and saved.xScale ~= nil then
        pos = UDim2.new(saved.xScale, saved.xOffset or 0, saved.yScale or 0.5, saved.yOffset or 0)
    end

    local card = mk("Frame", {
        Name = "A2FloatingPreview", AnchorPoint = anchor, Position = pos, Size = size,
        BackgroundColor3 = C.bgPanel, BackgroundTransparency = 0.06,
        BorderSizePixel = 0, Visible = false, ZIndex = 150, Parent = self.Gui,
    })
    corner(card, 14); stroke(card, C.glow, 1.4, 0.35)
    mk("UIGradient", { Color = GRADIENT_PANEL, Rotation = 135, Parent = card })

    local header = mk("Frame", {
        Name = "Header", Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1,
        ZIndex = 152, Parent = card,
    })
    local title = mk("TextLabel", {
        Size = UDim2.new(1, -104, 1, 0), Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = opts.Title or "LIVE CHARACTER",
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 153, Parent = header,
    })
    textGlow(title, C.glow, .6)

    local liveBtn = mk("TextButton", {
        Name = "LiveToggle", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(52, 20), BackgroundColor3 = C.good,
        BackgroundTransparency = 0.08, BorderSizePixel = 0, AutoButtonColor = true,
        Text = "LIVE", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.bgDeep,
        ZIndex = 153, Parent = header,
    })
    corner(liveBtn, 8); stroke(liveBtn, C.glow, 1, .4)

    local lockBtn = mk("TextButton", {
        Name = "LockToggle", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -66, 0.5, 0),
        Size = UDim2.fromOffset(34, 20), BackgroundColor3 = C.warn,
        BackgroundTransparency = 0.08, BorderSizePixel = 0, AutoButtonColor = true,
        Text = "LOCK", Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = C.bgDeep,
        ZIndex = 153, Parent = header,
    })
    corner(lockBtn, 8); stroke(lockBtn, C.glow, 1, .4)

    local viewport = mk("ViewportFrame", {
        Name = "AvatarViewport", Size = UDim2.new(1, -16, 1, -44),
        Position = UDim2.fromOffset(8, 36), BackgroundColor3 = C.bgDeep,
        BorderSizePixel = 0, Ambient = C.primary, LightColor = C.white,
        LightDirection = Vector3.new(-1, -1, -2), ZIndex = 151, Parent = card,
    })
    corner(viewport, 10)

    local engine = createAvatarEngine(viewport, {
        Live = opts.Live ~= false, Rotate = opts.Rotate,
        RotationSpeed = opts.RotationSpeed, UserId = opts.UserId,
        LoadingText = opts.LoadingText, MissingText = opts.MissingText,
    })

    local function persist()
        saveFloatingPreviewState({
            xScale = card.Position.X.Scale, xOffset = card.Position.X.Offset,
            yScale = card.Position.Y.Scale, yOffset = card.Position.Y.Offset,
            locked = locked,
        })
    end

    local function refreshLive()
        if engine:IsLive() then
            liveBtn.Text = "LIVE"; liveBtn.BackgroundColor3 = C.good
        else
            liveBtn.Text = "STOP"; liveBtn.BackgroundColor3 = C.secondary
        end
    end
    local function refreshLock()
        if locked then
            lockBtn.Text = "LOCK"; lockBtn.BackgroundColor3 = C.warn
        else
            lockBtn.Text = "MOVE"; lockBtn.BackgroundColor3 = C.secondary
        end
    end
    refreshLive(); refreshLock()

    liveBtn.MouseButton1Click:Connect(function()
        engine:SetLive(not engine:IsLive())
        refreshLive()
    end)
    lockBtn.MouseButton1Click:Connect(function()
        locked = not locked
        refreshLock()
        persist()
    end)

    -- Drag: bisa digeser dari header maupun area karakter (default tidak terkunci).
    -- v4.8: memakai akumulasi Delta supaya tidak lompat-lompat saat digeser,
    -- dan posisi selalu di-clamp agar kartu tidak keluar layar.
    local dragConns = {}
    local dragPointer, dragMoved, dragAccum = nil, false, 0

    local function clampCard()
        local guiObj = self.Gui
        local screen = guiObj and guiObj.AbsoluteSize or Vector2.new(1280, 720)
        if screen.X < 1 or screen.Y < 1 then return end
        local origin = guiObj and guiObj.AbsolutePosition or Vector2.new(0, 0)
        local ap, sz = card.AbsolutePosition, card.AbsoluteSize
        local minLeft, minTop = origin.X + 4, origin.Y + 4
        local maxLeft = math.max(minLeft, origin.X + screen.X - sz.X - 4)
        local maxTop = math.max(minTop, origin.Y + screen.Y - sz.Y - 4)
        local newLeft = math.clamp(ap.X, minLeft, maxLeft)
        local newTop = math.clamp(ap.Y, minTop, maxTop)
        -- Geser lewat Delta offset supaya AnchorPoint & Scale tetap utuh (anti-loncat).
        if math.abs(newLeft - ap.X) > 0.5 or math.abs(newTop - ap.Y) > 0.5 then
            local p = card.Position
            card.Position = UDim2.new(p.X.Scale, p.X.Offset + (newLeft - ap.X),
                p.Y.Scale, p.Y.Offset + (newTop - ap.Y))
        end
    end

    local function beginDrag(input)
        if locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragPointer, dragMoved, dragAccum = input, false, 0
        end
    end

    local function endDrag(input)
        if not dragPointer then return end
        local isTouch = dragPointer.UserInputType == Enum.UserInputType.Touch
        if isTouch then
            if input ~= dragPointer then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        if dragMoved then persist() end
        dragPointer, dragMoved, dragAccum = nil, false, 0
        clampCard()
    end

    table.insert(dragConns, header.InputBegan:Connect(beginDrag))
    table.insert(dragConns, viewport.InputBegan:Connect(beginDrag))
    table.insert(dragConns, UserInputService.InputChanged:Connect(function(input)
        if not dragPointer then return end
        local isTouch = dragPointer.UserInputType == Enum.UserInputType.Touch
        if isTouch then
            if input ~= dragPointer then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local d = input.Delta
        if not d or d.Magnitude <= 0 then return end
        dragAccum = dragAccum + d.Magnitude
        if not dragMoved and dragAccum < 6 then return end
        dragMoved = true
        local p = card.Position
        card.Position = UDim2.new(p.X.Scale, p.X.Offset + d.X, p.Y.Scale, p.Y.Offset + d.Y)
        clampCard()
    end))
    table.insert(dragConns, UserInputService.InputEnded:Connect(endDrag))

    -- Pastikan kartu selalu terlihat penuh saat dibuat / layar berubah.
    task.defer(clampCard)
    table.insert(dragConns, self.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(clampCard))

    card.Destroying:Connect(function()
        engine:Destroy()
        for _, c in ipairs(dragConns) do c:Disconnect() end
        dragConns = {}
    end)
    self.FloatingPreview = card
    return card
end

