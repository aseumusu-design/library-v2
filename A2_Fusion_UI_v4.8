function Section:_row(title, desc)
    self._count = self._count + 1
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = self._count, Parent = self._inner,
    })
    local textHolder = mk("Frame", {
        Size = UDim2.new(1, -60, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = row,
    })
    vlist(textHolder, 2)
    local t = mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Text = title or "", Font = Enum.Font.GothamBold,
        TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, Parent = textHolder,
    })
    local d
    if desc and desc ~= "" then
        d = mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = desc, Font = Enum.Font.Gotham,
            TextSize = 11, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true, Parent = textHolder,
        })
    end
    return row, t, d
end

-- ═══════════════════════ TOGGLE ═══════════════════════════════════════════
function Section:Toggle(opts)
    opts = opts or {}
    local row = self:_row(opts.Title, opts.Desc)
    local state = opts.Value and true or false

    local sw = mk("Frame", {
        Size = UDim2.new(0, 42, 0, 22), Position = UDim2.new(1, -42, 0, 0),
        BackgroundColor3 = C.bgHover, BorderSizePixel = 0, Parent = row,
    })
    corner(sw, 11)
    stroke(sw, C.stroke, 1, 0.5)

    local knob = mk("Frame", {
        Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = C.dim, BorderSizePixel = 0, Parent = sw,
    })
    corner(knob, 8)

    local function render()
        TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {
            Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
            BackgroundColor3 = state and C.white or C.dim,
        }):Play()
        TweenService:Create(sw, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {
            BackgroundColor3 = state and C.primary or C.bgHover,
        }):Play()
    end
    render()

    local function setState(v, fire)
        state = v and true or false
        render()
        if fire ~= false and opts.Callback then
            task.spawn(function() opts.Callback(state) end)
        end
    end

    local hit = mk("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = row,
    })
    hit.MouseButton1Click:Connect(function() setState(not state, true) end)

    -- Config save/load support (pakai opts.Flag)
    if opts.Flag and self.Tab and self.Tab.Window then
        local w = self.Tab.Window
        local _set = setState
        setState = function(v, fire)
            _set(v, fire)
            if fire ~= false then w:_autoSave() end
        end
        w:RegisterConfigElement(opts.Flag,
            function() return state end,
            function(v) setState(v, false) end)
    end

    return { Set = function(_, v, f) setState(v, f) end, Get = function() return state end }
end

-- ══════════════════════════════════════════════════════════════════════════════
--  SLIDER + RANGE SLIDER  (mouse + touch + FULL KEYBOARD)
--  100% self-contained A2 Fusion — tidak memakai library luar apa pun.
--
--  Kontrol keyboard (setelah slider diklik / difokuskan):
--    ← / ↓        kurangi 1 step
--    → / ↑        tambah 1 step
--    PageDown     kurangi 10 step
--    PageUp       tambah 10 step
--    Home         nilai minimum
--    End          nilai maksimum
--    Shift+panah  step halus (1/10 step)
--    Ctrl+panah   step kasar (10x step)
--    Enter        ketik nilai langsung (Enter lagi untuk simpan)
--    Tab          (RangeSlider) pindah handle kiri/kanan
--  Klik di luar slider = lepas fokus.
-- ══════════════════════════════════════════════════════════════════════════════

-- Format angka tanpa ekor float yang jelek (0.30000000000000004 → 0.3)
local function _a2FmtNum(n)
    n = tonumber(n) or 0
    if math.abs(n - math.floor(n + 0.5)) < 1e-6 then
        return tostring(math.floor(n + 0.5))
    end
    local s = string.format("%.4f", n)
    s = s:gsub("0+$", ""):gsub("%.$", "")
    return s
end

local function _a2PointIn(gui, x, y)
    if not gui or not gui.Parent then return false end
    local p, s = gui.AbsolutePosition, gui.AbsoluteSize
    return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function _a2Visible(gui)
    local g = gui
    while g do
        if g:IsA("GuiObject") and not g.Visible then return false end
        g = g.Parent
    end
    return true
end

-- Satu fokus keyboard global untuk semua slider / range slider.
local _a2SliderFocus = nil
local _a2SliderDrag = nil

local function _a2BlurSlider()
    local e = _a2SliderFocus
    _a2SliderFocus = nil
    if e and e.blur then pcall(e.blur) end
end

local function _a2FocusSlider(entry)
    if _a2SliderFocus == entry then return end
    if _a2SliderFocus and _a2SliderFocus.blur then pcall(_a2SliderFocus.blur) end
    _a2SliderFocus = entry
    if entry and entry.focus then pcall(entry.focus) end
end

-- Satu koneksi global untuk semua slider (hemat koneksi walau fitur ratusan).
if not A2UI._a2SliderKeyConn then
    A2UI._a2SliderKeyConn = UserInputService.InputBegan:Connect(function(input, gpe)
        -- Klik di luar slider aktif → lepas fokus.
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local e = _a2SliderFocus
            if e and e.hitTest and not e.hitTest(input.Position.X, input.Position.Y) then
                _a2BlurSlider()
            end
        end
        if gpe then return end
        if UserInputService:GetFocusedTextBox() then return end
        local e = _a2SliderFocus
        if e and e.visible and not e.visible() then
            _a2BlurSlider()
            return
        end
        if e and e.key then pcall(e.key, input) end
    end)
end

if not A2UI._a2SliderDragConn then
    A2UI._a2SliderDragConn = UserInputService.InputChanged:Connect(function(input)
        local held = input.UserInputType == Enum.UserInputType.Touch
            or (input.UserInputType == Enum.UserInputType.MouseMovement
                and UserInputService:IsMouseButtonPressed(Enum.UserInputButton.MouseButton1))
        if _a2SliderDrag and held then
            _a2SliderDrag(input.Position.X)
        end
    end)
    A2UI._a2SliderDragEndConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            _a2SliderDrag = nil
        end
    end)
end

-- ══════════════════════════════════════════════════════════════════════════════
--  SLIDER
-- ══════════════════════════════════════════════════════════════════════════════
function Section:Slider(opts)
    opts = opts or {}
    local v = opts.Value or {}
    local min = tonumber(v.Min) or 0
    local max = tonumber(v.Max) or 100
    if max < min then min, max = max, min end
    local step = tonumber(opts.Step) or 1
    if step <= 0 then step = 1 end
    local cur = tonumber(v.Default) or min
    cur = math.clamp(cur, min, max)

    local row = self:_row(opts.Title, opts.Desc)
    local range = max - min

    local function snap(val, s)
        s = s or step
        val = tonumber(val) or cur
        if s > 0 then
            val = min + math.floor((val - min) / s + 0.5) * s
        end
        return math.clamp(val, min, max)
    end

    local badge = mk("TextButton", {
        Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X,
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = C.bgHover, BorderSizePixel = 0,
        Text = "  " .. _a2FmtNum(cur) .. "  ", Font = Enum.Font.GothamMedium,
        TextSize = 11, TextColor3 = C.secondary, AutoButtonColor = false, Parent = row,
    })
    corner(badge, 6)

    local track = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 0, 30),
        BackgroundColor3 = C.bgHover, BorderSizePixel = 0, Parent = row,
    })
    corner(track, 4)
    local trackStroke = stroke(track, C.stroke, 1, 0.6)

    local fill = mk("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.primary,
        BorderSizePixel = 0, Parent = track,
    })
    corner(fill, 4)
    mk("UIGradient", { Color = GRADIENT_HOT, Rotation = 0, Parent = fill })

    local knob = mk("Frame", {
        Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = C.white,
        BorderSizePixel = 0, Parent = track, ZIndex = 2,
    })
    corner(knob, 8)
    local knobStroke = stroke(knob, C.secondary, 2, 0)

    -- Area klik lebih besar dari track supaya gampang di HP / mouse.
    local hit = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, 22),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        ZIndex = 5, Parent = row,
    })

    local dragging = false
    local editing = false
    local entry

    local function render()
        local a = range > 0 and (cur - min) / range or 0
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        if not editing then badge.Text = "  " .. _a2FmtNum(cur) .. "  " end
    end

    local function setVal(val, fire, s)
        cur = snap(val, s or step)
        render()
        if fire ~= false and opts.Callback then
            task.spawn(function() opts.Callback(cur) end)
        end
    end

    local function setFocus(on)
        if on then
            trackStroke.Color = C.primary
            trackStroke.Transparency = 0.05
            trackStroke.Thickness = 1.5
            knobStroke.Color = C.primary
            badge.BackgroundColor3 = C.primary
            badge.TextColor3 = C.bgDeep
        else
            trackStroke.Color = C.stroke
            trackStroke.Transparency = 0.6
            trackStroke.Thickness = 1
            knobStroke.Color = C.secondary
            badge.BackgroundColor3 = C.bgHover
            badge.TextColor3 = C.secondary
        end
    end

    local function fromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        setVal(min + a * range, true)
    end

    local function beginEdit()
        if editing then return end
        editing = true
        badge.Visible = false
        local box = mk("TextBox", {
            Size = UDim2.new(0, 74, 0, 22), AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, -1), BackgroundColor3 = C.bgDeep,
            BorderSizePixel = 0, Text = _a2FmtNum(cur), Font = Enum.Font.GothamMedium,
            TextSize = 11, TextColor3 = C.white, TextXAlignment = Enum.TextXAlignment.Center,
            ClearTextOnFocus = false, Parent = row, ZIndex = 10,
        })
        corner(box, 6)
        local bs = stroke(box, C.primary, 1, 0.1)
        box:CaptureFocus()
        task.defer(function()
            if box.Parent then
                box.SelectionStart = 1
                box.CursorPosition = #box.Text + 1
            end
        end)
        local done = false
        box.FocusLost:Connect(function()
            if done then return end
            done = true
            local n = tonumber(box.Text)
            editing = false
            box:Destroy()
            badge.Visible = true
            if n then setVal(n, true) else render() end
            if bs and bs.Parent then bs:Destroy() end
        end)
    end

    badge.MouseButton1Click:Connect(function()
        _a2FocusSlider(entry)
        beginEdit()
    end)

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            _a2FocusSlider(entry)
            dragging = true
            _a2SliderDrag = fromX
            fromX(input.Position.X)
        end
    end)

    entry = {
        focus = function() setFocus(true) end,
        blur = function() setFocus(false) end,
        hitTest = function(x, y) return _a2PointIn(row, x, y) end,
        visible = function() return _a2Visible(row) end,
        key = function(input)
            local kc = input.KeyCode
            if kc == Enum.KeyCode.Unknown then return end
            local fine = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
            local coarse = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            local s = step
            if fine then s = step / 10 elseif coarse then s = step * 10 end
            if kc == Enum.KeyCode.Left or kc == Enum.KeyCode.Down then
                setVal(cur - s, true, s)
            elseif kc == Enum.KeyCode.Right or kc == Enum.KeyCode.Up then
                setVal(cur + s, true, s)
            elseif kc == Enum.KeyCode.PageDown then
                setVal(cur - step * 10, true, step * 10)
            elseif kc == Enum.KeyCode.PageUp then
                setVal(cur + step * 10, true, step * 10)
            elseif kc == Enum.KeyCode.Home then
                setVal(min, true)
            elseif kc == Enum.KeyCode.End then
                setVal(max, true)
            elseif kc == Enum.KeyCode.Return or kc == Enum.KeyCode.KeypadEnter then
                beginEdit()
            end
        end,
    }

    render()

    -- Config save/load support (pakai opts.Flag)
    if opts.Flag and self.Tab and self.Tab.Window then
        local w = self.Tab.Window
        local _set = setVal
        setVal = function(val, fire, s)
            _set(val, fire, s)
            if fire ~= false then w:_autoSave() end
        end
        w:RegisterConfigElement(opts.Flag,
            function() return cur end,
            function(nv) setVal(nv, false) end)
    end

    return {
        Set = function(_, val) setVal(val, false) end,
        Get = function() return cur end,
        Focus = function() _a2FocusSlider(entry) end,
        Blur = function() if _a2SliderFocus == entry then _a2BlurSlider() end end,
        Frame = row,
    }
end

-- ══════════════════════════════════════════════════════════════════════════════
--  RANGE SLIDER  (dua handle: nilai minimum & maksimum)
--  opts.Value = { Min = 0, Max = 100, DefaultMin = 20, DefaultMax = 80 }
--  atau  opts.Value = { Min = 0, Max = 100, Default = { 20, 80 } }
--  Callback menerima { Min = lo, Max = hi }
-- ══════════════════════════════════════════════════════════════════════════════
function Section:RangeSlider(opts)
    opts = opts or {}
    local v = opts.Value or {}
    local min = tonumber(v.Min) or 0
    local max = tonumber(v.Max) or 100
    if max < min then min, max = max, min end
    local step = tonumber(opts.Step) or 1
    if step <= 0 then step = 1 end

    local lo = tonumber(v.DefaultMin) or min
    local hi = tonumber(v.DefaultMax) or max
    if type(v.Default) == "table" then
        lo = tonumber(v.Default[1]) or lo
        hi = tonumber(v.Default[2]) or hi
    elseif type(v.Default) == "number" then
        lo = tonumber(v.Default) or lo
    end
    lo = math.clamp(lo, min, max)
    hi = math.clamp(hi, min, max)
    if lo > hi then lo, hi = hi, lo end

    local row = self:_row(opts.Title, opts.Desc)
    local range = max - min

    local function snap(val, s)
        s = s or step
        val = tonumber(val) or lo
        if s > 0 then
            val = min + math.floor((val - min) / s + 0.5) * s
        end
        return math.clamp(val, min, max)
    end

    local badge = mk("TextButton", {
        Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X,
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = C.bgHover, BorderSizePixel = 0,
        Text = "  " .. _a2FmtNum(lo) .. " – " .. _a2FmtNum(hi) .. "  ",
        Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = C.secondary,
        AutoButtonColor = false, Parent = row,
    })
    corner(badge, 6)

    local track = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 0, 30),
        BackgroundColor3 = C.bgHover, BorderSizePixel = 0, Parent = row,
    })
    corner(track, 4)
    local trackStroke = stroke(track, C.stroke, 1, 0.6)

    local fill = mk("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.primary,
        BorderSizePixel = 0, Parent = track,
    })
    corner(fill, 4)
    mk("UIGradient", { Color = GRADIENT_HOT, Rotation = 0, Parent = fill })

    local function makeKnob()
        local k = mk("Frame", {
            Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = C.white,
            BorderSizePixel = 0, Parent = track, ZIndex = 2,
        })
        corner(k, 8)
        return k, stroke(k, C.secondary, 2, 0)
    end
    local knobLo, strokeLo = makeKnob()
    local knobHi, strokeHi = makeKnob()

    local hit = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, 22),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        ZIndex = 5, Parent = row,
    })

    local dragging = false
    local active = 1 -- 1 = handle kiri, 2 = handle kanan
    local editing = false
    local entry

    local function render()
        local aLo = range > 0 and (lo - min) / range or 0
        local aHi = range > 0 and (hi - min) / range or 0
        fill.Position = UDim2.new(aLo, 0, 0, 0)
        fill.Size = UDim2.new(math.max(aHi - aLo, 0), 0, 1, 0)
        knobLo.Position = UDim2.new(aLo, 0, 0.5, 0)
        knobHi.Position = UDim2.new(aHi, 0, 0.5, 0)
        if not editing then
            badge.Text = "  " .. _a2FmtNum(lo) .. " – " .. _a2FmtNum(hi) .. "  "
        end
    end

    local function setRange(newLo, newHi, fire, s)
        newLo = snap(newLo, s or step)
        newHi = snap(newHi, s or step)
        if newLo > newHi then newLo, newHi = newHi, newLo end
        lo, hi = newLo, newHi
        render()
        if fire ~= false and opts.Callback then
            task.spawn(function() opts.Callback({ Min = lo, Max = hi }) end)
        end
    end

    local function setActive(idx)
        active = idx == 2 and 2 or 1
        local onLo = active == 1
        strokeLo.Color = onLo and C.primary or C.secondary
        strokeLo.Thickness = onLo and 3 or 2
        strokeHi.Color = (not onLo) and C.primary or C.secondary
        strokeHi.Thickness = (not onLo) and 3 or 2
    end

    local function setFocus(on)
        if on then
            trackStroke.Color = C.primary
            trackStroke.Transparency = 0.05
            trackStroke.Thickness = 1.5
            badge.BackgroundColor3 = C.primary
            badge.TextColor3 = C.bgDeep
            setActive(active)
        else
            trackStroke.Color = C.stroke
            trackStroke.Transparency = 0.6
            trackStroke.Thickness = 1
            badge.BackgroundColor3 = C.bgHover
            badge.TextColor3 = C.secondary
            strokeLo.Color = C.secondary
            strokeLo.Thickness = 2
            strokeHi.Color = C.secondary
            strokeHi.Thickness = 2
        end
    end

    local function valueFromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        return min + a * range
    end

    local function pickKnob(x)
        local aLo = range > 0 and (lo - min) / range or 0
        local aHi = range > 0 and (hi - min) / range or 0
        local pxLo = track.AbsolutePosition.X + aLo * track.AbsoluteSize.X
        local pxHi = track.AbsolutePosition.X + aHi * track.AbsoluteSize.X
        return math.abs(x - pxLo) <= math.abs(x - pxHi) and 1 or 2
    end

    local function applyFromX(x)
        local val = valueFromX(x)
        if active == 1 then
            setRange(math.min(val, hi), hi, true)
        else
            setRange(lo, math.max(val, lo), true)
        end
    end

    local function beginEdit()
        if editing then return end
        editing = true
        badge.Visible = false
        local box = mk("TextBox", {
            Size = UDim2.new(0, 96, 0, 22), AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, -1), BackgroundColor3 = C.bgDeep,
            BorderSizePixel = 0, Text = _a2FmtNum(lo) .. "-" .. _a2FmtNum(hi),
            Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = C.white,
            TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false,
            Parent = row, ZIndex = 10,
        })
        corner(box, 6)
        local bs = stroke(box, C.primary, 1, 0.1)
        box:CaptureFocus()
        task.defer(function()
            if box.Parent then
                box.SelectionStart = 1
                box.CursorPosition = #box.Text + 1
            end
        end)
        local done = false
        box.FocusLost:Connect(function()
            if done then return end
            done = true
            local txt = box.Text
            local a, b = txt:match("(-?%d+%.?%d*)%s*[%-–,; ]%s*(-?%d+%.?%d*)")
            editing = false
            box:Destroy()
            badge.Visible = true
            if a and b then
                setRange(tonumber(a), tonumber(b), true)
            else
                local n = tonumber(txt)
                if n then setRange(n, hi, true) else render() end
            end
            if bs and bs.Parent then bs:Destroy() end
        end)
    end

    badge.MouseButton1Click:Connect(function()
        _a2FocusSlider(entry)
        beginEdit()
    end)

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            _a2FocusSlider(entry)
            setActive(pickKnob(input.Position.X))
            dragging = true
            _a2SliderDrag = applyFromX
            applyFromX(input.Position.X)
        end
    end)

    entry = {
        focus = function() setFocus(true) end,
        blur = function() setFocus(false) end,
        hitTest = function(x, y) return _a2PointIn(row, x, y) end,
        visible = function() return _a2Visible(row) end,
        key = function(input)
            local kc = input.KeyCode
            if kc == Enum.KeyCode.Unknown then return end
            local fine = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
            local coarse = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            local s = step
            if fine then s = step / 10 elseif coarse then s = step * 10 end
            if kc == Enum.KeyCode.Tab then
                setActive(active == 1 and 2 or 1)
                return
            end
            if kc == Enum.KeyCode.Left or kc == Enum.KeyCode.Down then
                if active == 1 then setRange(lo - s, hi, true, s)
                else setRange(lo, math.max(hi - s, lo), true, s) end
            elseif kc == Enum.KeyCode.Right or kc == Enum.KeyCode.Up then
                if active == 1 then setRange(math.min(lo + s, hi), hi, true, s)
                else setRange(lo, hi + s, true, s) end
            elseif kc == Enum.KeyCode.PageDown then
                if active == 1 then setRange(lo - step * 10, hi, true, step * 10)
                else setRange(lo, math.max(hi - step * 10, lo), true, step * 10) end
            elseif kc == Enum.KeyCode.PageUp then
                if active == 1 then setRange(math.min(lo + step * 10, hi), hi, true, step * 10)
                else setRange(lo, hi + step * 10, true, step * 10) end
            elseif kc == Enum.KeyCode.Home then
                if active == 1 then setRange(min, hi, true)
                else setRange(lo, math.max(min, lo), true) end
            elseif kc == Enum.KeyCode.End then
                if active == 1 then setRange(math.min(max, hi), hi, true)
                else setRange(lo, max, true) end
            elseif kc == Enum.KeyCode.Return or kc == Enum.KeyCode.KeypadEnter then
                beginEdit()
            end
        end,
    }

    setActive(1)
    render()

    -- Config save/load support (pakai opts.Flag)
    if opts.Flag and self.Tab and self.Tab.Window then
        local w = self.Tab.Window
        local _set = setRange
        setRange = function(a, b, fire, s)
            _set(a, b, fire, s)
            if fire ~= false then w:_autoSave() end
        end
        w:RegisterConfigElement(opts.Flag,
            function() return { Min = lo, Max = hi } end,
            function(nv)
                if type(nv) == "table" then
                    setRange(nv.Min or nv[1] or lo, nv.Max or nv[2] or hi, false)
                elseif type(nv) == "string" then
                    local a, b = nv:match("(-?%d+%.?%d*)%s*[%-–,; ]%s*(-?%d+%.?%d*)")
                    if a and b then setRange(tonumber(a), tonumber(b), false) end
                end
            end)
    end

    return {
        Set = function(_, a, b)
            if type(a) == "table" then
                setRange(a.Min or a[1], a.Max or a[2], false)
            else
                setRange(a, b, false)
            end
        end,
        Get = function() return { Min = lo, Max = hi } end,
        Focus = function() _a2FocusSlider(entry) end,
        Blur = function() if _a2SliderFocus == entry then _a2BlurSlider() end end,
        Frame = row,
    }
end

-- ═══════════════════════ BUTTON ═══════════════════════════════════════════
local function colorOf(c)
    if typeof(c) == "Color3" then return c end
    if type(c) == "string" then return C[c:lower()] or C.primary end
    return C.primary
end

function Section:Button(opts)
    opts = opts or {}
    self._count = self._count + 1
    local col = colorOf(opts.Color)

    local btn = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, opts.Desc and 44 or 36),
        BackgroundColor3 = col, BackgroundTransparency = 0.85, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, LayoutOrder = self._count, Parent = self._inner,
    })
    corner(btn, 10)
    stroke(btn, col, 1, 0.35)

    local title = mk("TextLabel", {
        Size = UDim2.new(1, opts.Icon and -38 or -16, 0, 16),
        Position = UDim2.new(0, opts.Icon and 32 or 10, 0, opts.Desc and 7 or 10),
        BackgroundTransparency = 1, Text = opts.Title or "Button",
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.text,
        TextXAlignment = opts.Justify == "Center" and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
        Parent = btn,
    })
    if opts.Icon then
        makeIcon(btn, opts.Icon, {
            Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(0, 8, 0.5, -11),
            Color = col,
        })
    end
    if opts.Glow then textGlow(title, col, tonumber(opts.GlowStrength) or 0.72) end
    if opts.Shine then shineText(title, col) end
    if opts.Desc then
        mk("TextLabel", {
            Size = UDim2.new(1, -16, 0, 14), Position = UDim2.new(0, 10, 0, 25),
            BackgroundTransparency = 1, Text = opts.Desc, Font = Enum.Font.Gotham,
            TextSize = 10, TextColor3 = C.dim,
            TextXAlignment = opts.Justify == "Center" and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
            Parent = btn,
        })
    end

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundTransparency = 0.65 }):Play()
        if opts.Glow then TweenService:Create(title, TweenInfo.new(0.12), { TextStrokeTransparency = 0.35 }):Play() end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundTransparency = 0.85 }):Play()
        if opts.Glow then TweenService:Create(title, TweenInfo.new(0.12), { TextStrokeTransparency = tonumber(opts.GlowStrength) or 0.72 }):Play() end
    end)
    btn.MouseButton1Click:Connect(function()
        if opts.Callback then task.spawn(function() opts.Callback() end) end
    end)
    return btn
end

-- ═══════════════════════ INPUT ════════════════════════════════════════════
function Section:Input(opts)
    opts = opts or {}
    self._count = self._count + 1
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = self._count, Parent = self._inner,
    })
    mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
        Text = opts.Title or "Input", Font = Enum.Font.GothamBold,
        TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local box = mk("TextBox", {
        Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0, 20),
        BackgroundColor3 = C.bgHover, BorderSizePixel = 0, Text = opts.Value or "",
        PlaceholderText = opts.Placeholder or "", PlaceholderColor3 = C.dim,
        Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = row,
    })
    corner(box, 8); stroke(box, C.stroke, 1, 0.5)
    pad(box, 0, 10, 0, 10)

    box.Focused:Connect(function() stroke(box, C.secondary, 1, 0.15) end)
    box.FocusLost:Connect(function()
        stroke(box, C.stroke, 1, 0.5)
        if opts.Flag and self.Tab and self.Tab.Window then self.Tab.Window:_autoSave() end
        if opts.Callback then task.spawn(function() opts.Callback(box.Text) end) end
    end)

    -- Config save/load support (pakai opts.Flag)
    if opts.Flag and self.Tab and self.Tab.Window then
        self.Tab.Window:RegisterConfigElement(opts.Flag,
            function() return box.Text end,
            function(v)
                box.Text = tostring(v or "")
                if opts.Callback then pcall(function() opts.Callback(box.Text) end) end
            end)
    end

    return box
end

-- ═══════════════════════ DROPDOWN ═════════════════════════════════════════
function Section:Dropdown(opts)
    opts = opts or {}
    self._count = self._count + 1
    local values = opts.Values or {}
    local current = opts.Value
    local open = false

    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = self._count, Parent = self._inner,
    })
    mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
        Text = opts.Title or "Dropdown", Font = Enum.Font.GothamBold,
        TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local btn = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0, 20),
        BackgroundColor3 = C.bgHover, BorderSizePixel = 0,
        Text = "  " .. tostring(current or "Pilih..."), Font = Enum.Font.Gotham,
        TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false, Parent = row,
    })
    corner(btn, 8); stroke(btn, C.stroke, 1, 0.5)

    local listFrame = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 58),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.bgPanel,
        BorderSizePixel = 0, Visible = false, Parent = row,
    })
    corner(listFrame, 8); stroke(listFrame, C.glow, 1, 0.3)
    local listScroll = mk("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.primary, CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = listFrame,
    })
    vlist(listScroll, 2); pad(listScroll, 6, 6, 6, 6)
    mk("UISizeConstraint", { MaxSize = Vector2.new(9999, 180), Parent = listScroll })

    local obj = {}
    local function rebuild()
        for _, ch in ipairs(listScroll:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        for i, val in ipairs(values) do
            local selected = tostring(val) == tostring(current)
            local it = mk("TextButton", {
                Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = selected and C.primary or C.bgRow,
                BackgroundTransparency = selected and 0.7 or 1,
                BorderSizePixel = 0, Text = "  " .. tostring(val), Font = Enum.Font.Gotham,
                TextSize = 11, TextColor3 = selected and C.white or C.text,
                TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                LayoutOrder = i, Parent = listScroll,
            })
            corner(it, 6)
            it.MouseButton1Click:Connect(function()
                current = val
                btn.Text = "  " .. tostring(val)
                open = false
                listFrame.Visible = false
                if opts.Flag and self.Tab and self.Tab.Window then self.Tab.Window:_autoSave() end
                if opts.Callback then task.spawn(function() opts.Callback(val) end) end
            end)
        end
    end
    rebuild()

    btn.MouseButton1Click:Connect(function()
        open = not open
        listFrame.Visible = open
        if open then rebuild() end
    end)

    -- Config save/load support (pakai opts.Flag)
    if opts.Flag and self.Tab and self.Tab.Window then
        self.Tab.Window:RegisterConfigElement(opts.Flag,
            function() return current end,
            function(v) obj.Select(v) end)
    end

    obj.Refresh = function(newValues) values = newValues or {}; rebuild() end
    obj.Select = function(val)
        current = val; btn.Text = "  " .. tostring(val)
        if opts.Callback then task.spawn(function() pcall(opts.Callback, val) end) end
    end
    obj.Get = function() return current end
    return obj
end

