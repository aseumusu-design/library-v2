local function enableInvisibility()
    local character = LocalPlayer.Character
    if not character then return false end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    
    if not hrp or not humanoid or not torso then
        warn("❌ Character belum fully loaded!")
        return false
    end
    
    savedPos = hrp.CFrame
    
    --// Step 1: Hancurkan semua visual (accessories, clothing, face)
    for _, obj in pairs(character:GetDescendants()) do
        if obj:IsA("Accessory") then
            obj:Destroy()
        elseif obj:IsA("Clothing") or obj:IsA("ShirtGraphic") then
            obj:Destroy()
        elseif obj:IsA("Decal") and obj.Parent and obj.Parent.Name == "Head" then
            obj:Destroy()
        elseif obj:IsA("BillboardGui") then
            obj:Destroy()
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
            obj:Destroy()
        elseif obj:IsA("Sound") then
            obj.Volume = 0
        end
    end
    
    --// Step 2: Transparanin semua BasePart
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = 1
            part.CastShadow = false
        elseif part:IsA("BasePart") and part.Name == "HumanoidRootPart" then
            part.Transparency = 1
            part.Size = Vector3.new(0.01, 0.01, 0.01)
        end
    end
    
    --// Step 3: Teleport ke posisi jauh (atas map / void)
    -- Posisi ini HARUS di atas map VD, jangan terlalu jauh
    local teleportPos = Vector3.new(0, 500, 0) -- Atas langit VD
    
    pcall(function()
        character:MoveTo(teleportPos)
    end)
    
    task.wait(0.15)
    
    --// Step 4: Buat Seat & Weld ke Torso
    invisChair = Instance.new("Seat")
    invisChair.Name = "invischair_vd2026"
    invisChair.Anchored = false
    invisChair.CanCollide = false
    invisChair.Transparency = 1
    invisChair.Size = Vector3.new(1, 1, 1)
    invisChair.Parent = Workspace
    
    local weld = Instance.new("Weld")
    weld.Part0 = invisChair
    weld.Part1 = torso
    weld.Parent = invisChair
    
    task.wait(0.05)
    
    --// Step 5: Teleport Seat balik ke posisi asli
    -- Ini yang bikin "glitch" — character di posisi jauh tapi seat di posisi asli
    invisChair.CFrame = savedPos
    
    --// Step 6: Maintain loop
    seatConnection = RunService.Heartbeat:Connect(function()
        if not isInvisible then return end
        if invisChair and invisChair.Parent then
            -- Seat tetap di posisi asli, character di posisi jauh
            invisChair.CFrame = savedPos
        end
        -- Maintain transparency
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency ~= 1 then
                part.Transparency = 1
            end
        end
    end)
    
    return true
end

local function disableInvisibility()
    if seatConnection then
        seatConnection:Disconnect()
        seatConnection = nil
    end
    
    if invisChair then
        pcall(function() invisChair:Destroy() end)
        invisChair = nil
    end
    
    -- Respawn aja paling bersih
    pcall(function()
        LocalPlayer.Character:BreakJoints()
    end)
    
    isInvisible = false
    statusLabel.Text = "Status: VISIBLE"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 80)
    toggleBtn.Text = "Toggle Invisible [INSERT]"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end

--// Toggle
local function toggleInvis()
    if isInvisible then
        disableInvisibility()
        return
    end
    
    isInvisible = true
    statusLabel.Text = "Status: ACTIVATING..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    
    local success = enableInvisibility()
    
    if success then
        statusLabel.Text = "Status: INVISIBLE 👻"
        statusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleBtn.Text = "MATIKAN (Respawn)"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        print("✅ VD Invis 2026: AKTIF")
        print("⚠️  JANGAN LARI KENCANG! Risiko ban!")
    else
        statusLabel.Text = "Status: GAGAL"
        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        isInvisible = false
    end
end

--// Events
toggleBtn.MouseButton1Click:Connect(toggleInvis)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Insert and not gameProcessed then
        toggleInvis()
    end
end)

--// Drag GUI
local dragging, dragStart, startPos = false, nil, nil

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

